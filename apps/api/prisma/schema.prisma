// SkillSplore data model.
// Standard PostgreSQL. Portable, migratable, no proprietary provider features.

generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev on whatever host runs `prisma generate`.
  // debian-openssl-3.0.x is pinned explicitly for the Docker image
  // (Debian bookworm) rather than relying on auto-detection, since the
  // build stage generating the client doesn't have openssl installed
  // and can misdetect the target the runtime stage actually needs.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  STUDENT
  TUTOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum EmailTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

// ONLINE / IN_PERSON / BOTH. For student requests, BOTH means "either".
enum DeliveryMode {
  ONLINE
  IN_PERSON
  BOTH
}

enum TutorProfileStatus {
  DRAFT
  PENDING
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  SUSPENDED
  PAUSED
}

enum RequestStatus {
  DRAFT
  OPEN
  PAUSED
  CLOSED
}

// LEARNING: "teach me this". SERVICE: "do this for me". Same request/response/
// messaging pipeline either way — only the framing and a few copy strings differ.
enum RequestKind {
  LEARNING
  SERVICE
}

enum ResponseStatus {
  PENDING
  WITHDRAWN
  DECLINED
  ACCEPTED
}

enum EngagementStatus {
  ARRANGED
  COMPLETED
  CANCELLED
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

enum ReportStatus {
  OPEN
  INVESTIGATING
  DISMISSED
  RESOLVED
}

enum ReportEntityType {
  TUTOR_PROFILE
  REQUEST
  MESSAGE
  REVIEW
  USER
}

enum ConversationContext {
  DIRECT_ENQUIRY
  REQUEST_RESPONSE
}

// ---------------------------------------------------------------------------
// Accounts
// ---------------------------------------------------------------------------

model User {
  id              Int        @id @default(autoincrement())
  email           String     @unique
  /// Null for an account that only ever signed in through Google or another
  /// provider. Such a person has no password here to steal, and the login
  /// route must say so plainly rather than reporting a wrong password.
  passwordHash    String?
  displayName     String
  bio             String?
  avatarKey       String?
  roles           Role[]     @default([STUDENT])
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  termsAcceptedAt DateTime?
  suspendedAt     DateTime?
  suspendedReason String?
  deletedAt       DateTime?
  // Per-account brute-force lockout (separate from IP-based rate limiting).
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  // Self-declared at registration. NOT treated as reliable -- a checkbox stops
  // nobody determined. Its purpose is that the platform never KNOWINGLY
  // arranges an in-person meeting between a child and an adult stranger: the
  // difference between being deceived and having designed for it.
  //
  // The only restriction it carries is that a minor's learning requests must
  // be online. Everything else -- browsing, posting, messaging, arranging
  // online lessons -- is unrestricted, and no adult has to act for a young
  // person to use the platform fully.
  isMinor          Boolean   @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  oauthAccounts            OAuthAccount[]
  tutorProfile             TutorProfile?
  requests                 TutoringRequest[]
  savedTutors              SavedTutor[]
  notifications            Notification[]
  verificationsReviewed    Verification[]            @relation("VerificationReviewer")
  emailTokens              EmailToken[]
  messages                 Message[]
  conversationParticipants ConversationParticipant[]
  engagements              Engagement[]
  reviewsWritten           Review[]
  reportsMade              Report[]
  blocksMade               Block[]                   @relation("Blocker")
  blocksReceived           Block[]                   @relation("Blocked")
  subjectSuggestionsMade     SubjectSuggestion[]      @relation("SuggestionSubmitter")
  subjectSuggestionsReviewed SubjectSuggestion[]      @relation("SuggestionReviewer")
  legalAcceptances           UserLegalAcceptance[]
  consents                   UserConsent[]
  privacyRequests            PrivacyRequest[]
  restrictions               AccountRestriction[]
  payments                   Payment[]
  feedback                   Feedback[]

  @@index([status])
}

model EmailToken {
  id        Int            @id @default(autoincrement())
  userId    Int
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      EmailTokenType
  tokenHash String         @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  @@index([userId, type])
}

// ---------------------------------------------------------------------------
// Taxonomy
// ---------------------------------------------------------------------------

model Category {
  id             Int       @id @default(autoincrement())
  name           String    @unique
  // Lowercased, accent- and punctuation-stripped form of `name`, used to catch
  // near-duplicates ("Music" vs "music" vs "Music ") at the database level.
  normalizedName String    @unique
  slug           String    @unique
  icon           String?
  description    String?
  // The catalogue is far too large to show in full on the homepage; only a
  // handful are featured there, and the rest are reached through search and
  // the browse page.
  isFeatured     Boolean   @default(false)
  /// Which level vocabularies apply here. An array because plenty of
  /// categories genuinely span both: Music is taught for NCEA and as a hobby,
  /// Computer Science covers Digital Technologies and professional
  /// engineering. Defaults to PROFESSIONAL -- a category someone submits at
  /// runtime is far more often a skill than a school subject.
  levelTracks    LevelTrack[] @default([PROFESSIONAL])
  // Archived rather than deleted, so historical requests and profiles that
  // reference a retired category keep working.
  isActive       Boolean   @default(true)
  displayOrder   Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  subjects       Subject[]
  aliases        TaxonomyAlias[]
  suggestions    SubjectSuggestion[] @relation("SuggestedCategory")

  @@index([isFeatured, displayOrder])
}

model Subject {
  id             Int      @id @default(autoincrement())
  name           String   @unique
  normalizedName String   @unique
  slug           String   @unique
  description    String?
  categoryId     Int?
  category       Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  // Archived rather than deleted, matching Category, so a subject that is no
  // longer offered can drop out of search without breaking rows that
  // reference it (tutor profiles, past requests, engagements).
  isActive       Boolean  @default(true)
  displayOrder   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  tutorSubjects TutorSubject[]
  requests      TutoringRequest[]
  engagements   Engagement[]
  aliases       TaxonomyAlias[]
  resolvedFromSuggestions SubjectSuggestion[] @relation("ResolvedSubject")

  @@index([categoryId])
  @@index([isActive])
}

// Search synonyms ("maths" -> Mathematics, "coding" -> Programming). A row
// points at exactly one of a category or a subject, never both -- enforced in
// application code rather than the schema, since Prisma has no portable
// exactly-one-of-two-columns constraint.
model TaxonomyAlias {
  id             Int      @id @default(autoincrement())
  term           String
  normalizedTerm String   @unique
  categoryId     Int?
  category       Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subjectId      Int?
  subject        Subject?  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@index([categoryId])
  @@index([subjectId])
}

enum SuggestionStatus {
  PENDING
  APPROVED
  MERGED
  REJECTED
}

// A student or tutor proposing a subject that isn't in the catalogue yet.
// Never creates a Subject directly -- always goes through this review queue,
// or auto-resolves instantly if it turns out to already exist (see
// subjects.routes.ts), which is what actually keeps the catalogue from
// fragmenting into near-duplicates.
model SubjectSuggestion {
  id                  Int      @id @default(autoincrement())
  name                String
  normalizedName      String
  note                String?
  suggestedCategoryId Int?
  suggestedCategory   Category? @relation("SuggestedCategory", fields: [suggestedCategoryId], references: [id], onDelete: SetNull)
  newCategoryName     String?

  submittedById Int
  submittedBy   User   @relation("SuggestionSubmitter", fields: [submittedById], references: [id], onDelete: Cascade)

  status            SuggestionStatus @default(PENDING)
  resolvedSubjectId Int?
  resolvedSubject   Subject?         @relation("ResolvedSubject", fields: [resolvedSubjectId], references: [id], onDelete: SetNull)
  reviewedById      Int?
  reviewedBy        User?            @relation("SuggestionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote        String?

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([status])
  @@index([normalizedName])
}

/// Which vocabulary of levels a subject is described with.
///
/// The catalogue started NCEA-shaped, which fits about five of the 37
/// categories. Everyone else -- SEO, welding, tattooing, dog training -- had to
/// describe themselves with "Adult / Hobby" or a school year, because a level
/// was mandatory to submit a profile. Calling professional SEO consulting a
/// hobby is not a small wording problem; it is the platform mis-describing what
/// is on offer.
enum LevelTrack {
  /// School and university: Primary through Postgraduate.
  ACADEMIC
  /// Skill ladder: complete beginner through working professional.
  PROFESSIONAL
}

model TeachingLevel {
  id        Int    @id @default(autoincrement())
  name      String @unique
  slug      String @unique
  sortOrder Int    @default(0)
  /// Levels are offered per track; a tutor sees only the tracks their chosen
  /// subjects actually use.
  track     LevelTrack @default(ACADEMIC)

  tutorProfiles TutorProfile[] @relation("TutorLevels")
  requests      TutoringRequest[]
}

// ---------------------------------------------------------------------------
// Tutor profiles
// ---------------------------------------------------------------------------

model TutorProfile {
  id             Int                @id @default(autoincrement())
  userId         Int                @unique
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline       String?
  experience     String?
  teachingStyle  String?
  status         TutorProfileStatus @default(DRAFT)
  deliveryMode   DeliveryMode       @default(ONLINE)
  country        String?
  city           String?
  locationNote   String?
  travelRadiusKm Int?
  availabilityNote String?
  hourlyRateCents Int?
  currency       String             @default("NZD")
  yearsExperience Int?

  averageRating  Float              @default(0)
  ratingCount    Int                @default(0)

  submittedAt    DateTime?
  approvedAt     DateTime?
  reviewedById   Int?
  changeRequestNote String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  subjects       TutorSubject[]
  levels         TeachingLevel[]    @relation("TutorLevels")
  availability   AvailabilitySlot[]
  qualifications Qualification[]
  verifications  Verification[]
  commissions    Commission[]
  reviews        Review[]
  responses      RequestResponse[]
  savedBy        SavedTutor[]
  engagements    Engagement[]
  payments       Payment[]
  freeTierGrant  FreeTierGrant?

  @@index([status])
  @@index([country, city])
}

model TutorSubject {
  id             Int          @id @default(autoincrement())
  tutorProfileId Int
  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  subjectId      Int
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  priceCents     Int?

  @@unique([tutorProfileId, subjectId])
  @@index([subjectId])
}

model AvailabilitySlot {
  id             Int          @id @default(autoincrement())
  tutorProfileId Int
  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  dayOfWeek      Int // 0 = Sunday .. 6 = Saturday
  startMinute    Int // minutes from midnight
  endMinute      Int

  @@index([tutorProfileId])
}

model Qualification {
  id             Int          @id @default(autoincrement())
  tutorProfileId Int
  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  title          String
  institution    String?
  year           Int?
  // Private object-storage key. Never publicly served; access is authorised.
  documentKey    String?
  documentName   String?
  verifiedAt     DateTime?
  verifiedById   Int?
  createdAt      DateTime     @default(now())

  @@index([tutorProfileId])
}

enum VerificationType {
  IDENTITY_DOCUMENT
  QUALIFICATION_DOCUMENT
  EMAIL_CONFIRMED
}

// A specific, named check performed on a tutor -- never a generic "Verified"
// badge. `label` is the exact public-facing wording (e.g. "Qualification
// document checked"), shown with checkedAt and, where set, expiresAt. Public
// serialization must only surface active records: not revoked, not expired.
model Verification {
  id             Int              @id @default(autoincrement())
  tutorProfileId Int
  tutorProfile   TutorProfile     @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  type           VerificationType
  label          String
  evidenceRef    String?
  reviewedById   Int
  reviewedBy     User             @relation("VerificationReviewer", fields: [reviewedById], references: [id])
  checkedAt      DateTime         @default(now())
  expiresAt      DateTime?
  revokedAt      DateTime?
  revokedReason  String?

  @@index([tutorProfileId])
}

model SavedTutor {
  id             Int          @id @default(autoincrement())
  studentId      Int
  student        User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tutorProfileId Int
  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([studentId, tutorProfileId])
}

// ---------------------------------------------------------------------------
// Student requests + tutor responses
// ---------------------------------------------------------------------------

model TutoringRequest {
  id           Int           @id @default(autoincrement())
  studentId    Int
  student      User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId    Int
  subject      Subject       @relation(fields: [subjectId], references: [id])
  // Set when the poster chose "Other subject or skill" instead of picking
  // from the catalogue. subjectId still points at a real row (the seeded
  // "Other / not yet listed" placeholder) so every existing query that joins
  // on subject keeps working; this is what actually displays in that case.
  // Also becomes a SubjectSuggestion so the gap shows up for admin review.
  customSubjectLabel String?
  levelId      Int?
  level        TeachingLevel? @relation(fields: [levelId], references: [id], onDelete: SetNull)
  kind         RequestKind   @default(LEARNING)
  title        String
  description  String
  deliveryMode DeliveryMode  @default(BOTH)
  country      String?
  city         String?
  locationNote String?
  budgetMinCents Int?
  budgetMaxCents Int?
  currency     String        @default("NZD")
  timing       String?
  status       RequestStatus @default(DRAFT)
  hiddenAt     DateTime?
  publishedAt  DateTime?
  closedAt     DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  responses    RequestResponse[]
  engagements  Engagement[]

  @@index([status, subjectId])
  @@index([studentId])
  @@index([kind])
}

model RequestResponse {
  id               Int             @id @default(autoincrement())
  requestId        Int
  request          TutoringRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  tutorProfileId   Int
  tutorProfile     TutorProfile    @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  introduction     String
  proposedRateCents Int?
  availabilityNote String?
  status           ResponseStatus  @default(PENDING)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  // One active response per tutor per request.
  @@unique([requestId, tutorProfileId])
  @@index([tutorProfileId])
}

// ---------------------------------------------------------------------------
// Conversations + messaging
// ---------------------------------------------------------------------------

model Conversation {
  id             Int                 @id @default(autoincrement())
  context        ConversationContext @default(DIRECT_ENQUIRY)
  tutorProfileId Int?
  requestId      Int?
  lastMessageAt  DateTime            @default(now())
  createdAt      DateTime            @default(now())

  participants ConversationParticipant[]
  messages     Message[]

  @@index([lastMessageAt])
}

model ConversationParticipant {
  id             Int          @id @default(autoincrement())
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         Int
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  archivedAt     DateTime?

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       Int
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  hiddenAt       DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Block {
  id        Int      @id @default(autoincrement())
  blockerId Int
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId Int
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

// ---------------------------------------------------------------------------
// Engagements + reviews
// ---------------------------------------------------------------------------

model Engagement {
  id             Int              @id @default(autoincrement())
  studentId      Int
  student        User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tutorProfileId Int
  tutorProfile   TutorProfile     @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  subjectId      Int?
  subject        Subject?         @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  requestId      Int?
  request        TutoringRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  conversationId Int?
  title          String
  note           String?
  status         EngagementStatus @default(ARRANGED)
  createdAt      DateTime         @default(now())
  completedAt    DateTime?
  cancelledAt    DateTime?

  review         Review?
  commission     Commission?

  @@index([studentId])
  @@index([tutorProfileId])
}

/// Commission owed to SkillSplore for an introduction that became a lesson.
///
/// The revenue model is "we earn only when a tutor earns". SkillSplore does not
/// process lesson payments -- those are arranged directly between two people
/// and are invisible to us -- so there is no way to observe money changing
/// hands. What CAN be observed is that an introduction made here turned into a
/// lesson that both parties agree happened: an Engagement reaching COMPLETED.
/// That is the closest honest proxy, and it is what this accrues on.
///
/// This is a LEDGER, not a charge. Nothing here moves money. Rows accumulate so
/// that when a payment processor is connected there is an accurate history to
/// invoice from, and so a tutor can see what is accruing rather than meeting it
/// as a surprise.
model Commission {
  id             Int              @id @default(autoincrement())
  /// One commission per engagement, enforced by the unique constraint below.
  /// Completing an already-completed engagement must not accrue twice.
  engagementId   Int              @unique
  engagement     Engagement       @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  tutorProfileId Int
  tutorProfile   TutorProfile     @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)

  /// What the tutor says they were paid for this lesson, if they said. Null is
  /// normal and not a failure: declaring is optional, because a platform that
  /// cannot verify the number should not pretend the field is authoritative.
  basisCents     Int?
  currency       String           @default("NZD")

  /// The rate and flat component IN FORCE WHEN THIS ACCRUED, copied rather
  /// than referenced. Changing the price list later must not silently restate
  /// what a tutor already owes.
  rateBps        Int
  flatCents      Int
  /// flatCents + (basisCents * rateBps / 10000), computed at accrual.
  amountCents    Int

  status         CommissionStatus @default(PENDING)
  /// Set when the row is deliberately not collected -- inside a tutor's free
  /// allowance, or written off. Recorded rather than deleted so the history
  /// still shows the introduction happened.
  waivedReason   String?

  createdAt      DateTime         @default(now())
  invoicedAt     DateTime?
  paidAt         DateTime?

  @@index([tutorProfileId, status])
  @@index([status])
}

enum CommissionStatus {
  /// Accrued and owed, but nothing has been sent to the tutor yet.
  PENDING
  /// Included on an invoice. No charging exists yet; this is for when it does.
  INVOICED
  PAID
  /// Deliberately not collected. Free allowance, goodwill, or a dispute.
  WAIVED
}

model Review {
  id               Int          @id @default(autoincrement())
  // One review per engagement. Guarantees reviews tie to a real, completed
  // engagement (no unrelated reviews) and cannot be duplicated.
  engagementId     Int          @unique
  engagement       Engagement   @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  tutorProfileId   Int
  tutorProfile     TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  studentId        Int
  student          User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  rating           Int
  title            String?
  body             String
  categoryRatings  Json?
  status           ReviewStatus @default(PUBLISHED)
  hiddenReason     String?
  tutorResponse    String?
  tutorRespondedAt DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([tutorProfileId, status])
}

// ---------------------------------------------------------------------------
// Reports, moderation notes, notifications, audit
// ---------------------------------------------------------------------------

model Report {
  id             Int              @id @default(autoincrement())
  reporterId     Int
  reporter       User             @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  entityType     ReportEntityType
  entityId       Int
  reason         String
  details        String?
  status         ReportStatus     @default(OPEN)
  resolutionNote String?
  handledById    Int?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status])
  @@index([entityType, entityId])
}

// Generic internal note used for tutor-review notes and moderation notes.
model AdminNote {
  id         Int      @id @default(autoincrement())
  authorId   Int
  entityType String
  entityId   Int
  body       String
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  linkUrl   String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

// Append-only audit trail. Actor kept as a plain id so audit survives deletes.
model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int?
  action     String
  entityType String?
  entityId   Int?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ===========================================================================
// Legal documents, consent and privacy operations.
//
// Design rules that apply to everything in this section:
//
//   * Acceptance and consent evidence is APPEND-ONLY. Nothing here is updated
//     in place to reflect a newer decision -- a withdrawal is a new row, not
//     an edit. If a user later disputes what they agreed to, the record has to
//     show what the wording actually said at the moment they agreed to it,
//     which an updatable row cannot do.
//   * Consent rows store the exact text shown, not a reference to today's
//     version of the text. Documents get reworded; evidence must not move.
//   * Actor ids are plain integers without a foreign key where the record must
//     outlive the account (audit, disclosure, incident records).
// ===========================================================================

enum LegalDocumentSlug {
  TERMS
  PRIVACY
  COMMUNITY_GUIDELINES
  SAFETY
  ACADEMIC_INTEGRITY
  PROHIBITED_SERVICES
  COOKIES
  SUBPROCESSORS
}

// The current pointer for each policy. Content lives in the version rows.
model LegalDocument {
  id               Int               @id @default(autoincrement())
  slug             LegalDocumentSlug @unique
  title            String
  // Null until a version has been published. Deliberately nullable so a
  // document can exist in draft with no publishable version at all.
  currentVersionId Int?              @unique
  currentVersion   LegalDocumentVersion? @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt

  versions         LegalDocumentVersion[] @relation("DocumentVersions")
}

model LegalDocumentVersion {
  id           Int           @id @default(autoincrement())
  documentId   Int
  document     LegalDocument @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  // Human-facing version label, e.g. "2026-08-04-draft-1".
  version      String
  // The full rendered text as shown to users, frozen at publish time.
  body         String
  // Set only when a qualified lawyer has approved this exact version. Until
  // then the version is a draft and the UI must say so.
  legalReviewedAt DateTime?
  legalReviewedBy String?
  // Populated by the placeholder scanner (see src/lib/legalPlaceholders.ts).
  // A version with unresolved placeholders can never be marked production
  // ready, which is what keeps "[LEGAL ENTITY NAME]" off the live site.
  unresolvedPlaceholders String[] @default([])
  publishedAt  DateTime?
  effectiveAt  DateTime?
  createdAt    DateTime      @default(now())

  currentFor   LegalDocument?        @relation("CurrentVersion")
  acceptances  UserLegalAcceptance[]

  @@unique([documentId, version])
  @@index([documentId, publishedAt])
}

// Append-only. One row per user per version accepted.
/// A sign-in identity held with an external provider.
///
/// Separate from User because one person may link several -- Google today,
/// Apple later -- and because the provider's own id, not the email address, is
/// the stable key. Email addresses at a provider can be changed or reassigned;
/// the subject id cannot.
model OAuthAccount {
  id                Int           @id @default(autoincrement())
  userId            Int
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          OAuthProvider
  /// The provider's immutable subject identifier (Google's `sub` claim).
  providerAccountId String
  /// The address the provider reported at the time of linking. Recorded for
  /// support and audit only -- never used to find or match an account, because
  /// matching on a mutable address is how account-takeover bugs happen.
  email             String?
  createdAt         DateTime      @default(now())
  lastLoginAt       DateTime      @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

enum OAuthProvider {
  GOOGLE
}

model UserLegalAcceptance {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  versionId  Int
  version    LegalDocumentVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  // How acceptance happened, e.g. "registration", "reacceptance-prompt".
  method     String
  ipAddress  String?
  userAgent  String?
  acceptedAt DateTime @default(now())

  @@unique([userId, versionId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Consent
// ---------------------------------------------------------------------------

enum ConsentKind {
  MARKETING_EMAIL
  DATA_INSIGHTS
  ANALYTICS_COOKIES
}

// The exact wording of a consent request at a point in time. Consent rows
// reference this so evidence survives rewording.
model ConsentVersion {
  id                  Int         @id @default(autoincrement())
  kind                ConsentKind
  version             String
  // Verbatim text shown next to the checkbox.
  wording             String
  // What the consent does and does not cover, shown on the consent screen.
  purpose             String
  dataCategories      String[]    @default([])
  excludedCategories  String[]    @default([])
  recipientCategories String[]    @default([])
  countries           String[]    @default([])
  retentionSummary    String?
  withdrawalSummary   String?
  // Whether recipients are contractually required to delete on withdrawal,
  // and whether an already-completed disclosure can be recalled. Recorded
  // because the consent screen must state both, and the honest answer for a
  // report already delivered is usually "no".
  recipientsMustDeleteOnWithdrawal Boolean @default(false)
  priorDisclosuresReversible       Boolean @default(false)
  createdAt           DateTime    @default(now())

  consents            UserConsent[]

  @@unique([kind, version])
}

// Append-only consent evidence. A withdrawal does NOT rewrite these rows; it
// creates a ConsentWithdrawal and sets withdrawnAt for lookup convenience
// only. `grantedWording` duplicates the version text on purpose so the
// evidence is self-contained even if a version row is ever removed.
model UserConsent {
  id             Int            @id @default(autoincrement())
  userId         Int
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind           ConsentKind
  versionId      Int
  consentVersion ConsentVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  grantedWording String
  // "checkbox", "settings-toggle", etc. Never "implied".
  method         String
  ipAddress      String?
  userAgent      String?
  grantedAt      DateTime       @default(now())
  withdrawnAt    DateTime?
  auditReference String?

  withdrawals    ConsentWithdrawal[]

  @@index([userId, kind])
  @@index([kind, withdrawnAt])
}

model ConsentWithdrawal {
  id          Int         @id @default(autoincrement())
  consentId   Int
  consent     UserConsent @relation(fields: [consentId], references: [id], onDelete: Cascade)
  userId      Int
  reason      String?
  method      String
  // Tracks whether downstream recipients confirmed deletion, where the
  // contract required it. Null means "not applicable / nothing disclosed".
  downstreamDeletionStatus String?
  downstreamDeletionAt     DateTime?
  withdrawnAt DateTime    @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Privacy requests (access, correction, export, deletion, complaints)
// ---------------------------------------------------------------------------

enum PrivacyRequestType {
  ACCESS
  CORRECTION
  EXPORT
  DEACTIVATION
  DELETION
  MARKETING_OPT_OUT
  CONSENT_WITHDRAWAL
  COMPLAINT
  AUTOMATED_DECISION_ENQUIRY
}

enum PrivacyRequestStatus {
  RECEIVED
  IDENTITY_CHECK
  IN_PROGRESS
  AWAITING_USER
  COMPLETED
  REFUSED
  WITHDRAWN
}

model PrivacyRequest {
  id                Int                  @id @default(autoincrement())
  // Nullable: a person may make a privacy request about information held
  // about them without currently having (or ever having had) an account.
  userId            Int?
  user              User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  contactEmail      String
  type              PrivacyRequestType
  status            PrivacyRequestStatus @default(RECEIVED)
  details           String
  // Free text rather than an enum: the proportionate check differs per
  // request and the reviewer needs to record what they actually did.
  identityCheckNote String?
  outcomeNote       String?
  // Recorded when a request is refused or narrowed, since the user has to be
  // told the reason and it may be reviewed by a regulator later.
  refusalReason     String?
  handledBy         Int?
  dueAt             DateTime?
  closedAt          DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @default(now()) @updatedAt

  events            PrivacyRequestEvent[]

  @@index([status, createdAt])
  @@index([userId])
}

model PrivacyRequestEvent {
  id        Int            @id @default(autoincrement())
  requestId Int
  request   PrivacyRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actorId   Int?
  action    String
  note      String?
  createdAt DateTime       @default(now())

  @@index([requestId])
}

// ---------------------------------------------------------------------------
// Data governance registers
// ---------------------------------------------------------------------------

model Subprocessor {
  id                 Int      @id @default(autoincrement())
  name               String
  service            String
  // Country where the data actually rests. Never guessed -- left blank until
  // confirmed against the provider's own documentation.
  country            String?
  purpose            String
  dataCategories     String[] @default([])
  contractStatus     String   @default("NOT_REVIEWED")
  securityReviewedAt DateTime?
  retentionTerms     String?
  // Whether this provider is actually wired up right now, as opposed to being
  // planned. The public /subprocessors page lists only active ones.
  isActive           Boolean  @default(true)
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt

  @@unique([name, service])
}

model DataCategory {
  id               Int      @id @default(autoincrement())
  key              String   @unique
  label            String
  description      String
  // Whether this category may ever appear in an aggregate insights report.
  // Sensitive categories are false and the code checks this, so adding a new
  // sensitive field defaults it to excluded rather than included.
  insightsEligible Boolean  @default(false)
  isSensitive      Boolean  @default(false)
  createdAt        DateTime @default(now())

  retentionRules   RetentionRule[]
}

model RetentionRule {
  id         Int          @id @default(autoincrement())
  categoryId Int
  category   DataCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  // Null means "no period decided yet" -- deliberately not defaulted to a
  // number, because inventing a retention period is worse than admitting the
  // decision is outstanding.
  retainDays Int?
  basis      String?
  // Every rule starts unapproved. The retention job refuses to act on a rule
  // that no human has signed off.
  approvedBy String?
  approvedAt DateTime?
  notes      String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @default(now()) @updatedAt

  @@index([categoryId])
}

// Record of an actual disclosure of personal information to a third party,
// including under legal compulsion. Append-only.
model DataDisclosureRecord {
  id                Int      @id @default(autoincrement())
  recipientName     String
  recipientType     String
  legalBasis        String
  dataCategories    String[] @default([])
  // Null when the disclosure was not about identifiable individuals (for
  // example an aggregate report).
  affectedUserCount Int?
  requestReference  String?
  disclosedBy       Int?
  disclosedAt       DateTime @default(now())
  notes             String?

  @@index([disclosedAt])
}

// Every time a moderator or administrator opens private message content.
// A reason is mandatory at the API layer; this table is the evidence.
model ModeratorAccessLog {
  id             Int      @id @default(autoincrement())
  moderatorId    Int
  conversationId Int?
  messageId      Int?
  targetUserId   Int?
  reason         String
  // One of the permitted grounds in the Privacy Policy, e.g. "report",
  // "support", "fraud", "legal", "serious-harm".
  ground         String
  reportId       Int?
  createdAt      DateTime @default(now())

  @@index([moderatorId, createdAt])
  @@index([conversationId])
}

// ---------------------------------------------------------------------------
// Privacy incidents
// ---------------------------------------------------------------------------

enum PrivacyIncidentStatus {
  DETECTED
  CONTAINED
  ASSESSING
  NOTIFIED
  CLOSED
}

model PrivacyIncident {
  id                  Int                   @id @default(autoincrement())
  reference           String                @unique
  summary             String
  status              PrivacyIncidentStatus @default(DETECTED)
  detectedAt          DateTime
  containedAt         DateTime?
  dataCategories      String[]              @default([])
  affectedUserCount   Int?
  // Deliberately nullable and unset by default. Whether a breach is notifiable
  // is a case-by-case assessment recorded in BreachAssessment, not a value
  // this system decides on its own.
  regulatorNotifiedAt DateTime?
  usersNotifiedAt     DateTime?
  remediation         String?
  postIncidentReview  String?
  createdBy           Int?
  closedAt            DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @default(now()) @updatedAt

  assessments         BreachAssessment[]

  @@index([status, detectedAt])
}

model BreachAssessment {
  id                Int             @id @default(autoincrement())
  incidentId        Int
  incident          PrivacyIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  assessorId        Int?
  // The serious-harm question, answered explicitly rather than inferred.
  seriousHarmLikely Boolean?
  reasoning         String
  // Recorded separately from the incident so a changed conclusion leaves a
  // trail rather than overwriting the earlier view.
  recommendRegulatorNotification Boolean?
  recommendUserNotification      Boolean?
  assessedAt        DateTime        @default(now())

  @@index([incidentId])
}

// Restrictions short of full suspension (posting limits, messaging limits).
model AccountRestriction {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  reason    String
  imposedBy Int?
  expiresAt DateTime?
  liftedAt  DateTime?
  liftedBy  Int?
  createdAt DateTime  @default(now())

  @@index([userId, liftedAt])
}


// ===========================================================================
// Tutor signup fee.
//
// SkillSplore NEVER stores card numbers, expiry dates or security codes.
// There is no column here for them and there must never be one. Payment is
// taken through the processor's hosted checkout, so card data goes from the
// payer's browser directly to the processor. Keeping it that way is the
// difference between a small PCI-DSS self-assessment and a compliance project.
//
// What is stored: an amount, a status, and an opaque reference issued by the
// processor.
// ===========================================================================

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentKind {
  TUTOR_SIGNUP
}

model Payment {
  id             Int           @id @default(autoincrement())
  userId         Int
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tutorProfileId Int?
  tutorProfile   TutorProfile? @relation(fields: [tutorProfileId], references: [id], onDelete: SetNull)

  kind           PaymentKind   @default(TUTOR_SIGNUP)
  status         PaymentStatus @default(PENDING)
  // Cents, never a float. 1299 = NZD 12.99.
  amountCents    Int
  currency       String        @default("NZD")

  provider       String
  // The processor's own id for this checkout/charge. Unique so a webhook
  // replay -- which processors do deliberately, and which also happens when a
  // retry crosses a timeout -- cannot create a second payment row.
  providerRef    String?       @unique
  // Our idempotency key, generated before the processor is called, so a
  // double-submitted form cannot open two checkouts for the same profile.
  idempotencyKey String        @unique

  // Human-facing receipt identifier, assigned on success.
  receiptNumber  String?       @unique
  failureReason  String?

  createdAt      DateTime      @default(now())
  paidAt         DateTime?
  refundedAt     DateTime?
  refundReason   String?
  updatedAt      DateTime      @default(now()) @updatedAt

  @@index([userId, status])
  @@index([status, createdAt])
}

// Records that a tutor was admitted under the free-tier promotion, and which
// numbered slot they took.
//
// slotNumber is unique, so even if the counter below were somehow bypassed,
// the database still refuses to issue the same slot twice. Belt and braces on
// purpose: "the first 50 are free" is a public promise, and quietly giving
// away 60 is both a revenue leak and a fairness problem.
model FreeTierGrant {
  id             Int          @id @default(autoincrement())
  userId         Int
  tutorProfileId Int          @unique
  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  slotNumber     Int          @unique
  // Copied from config at grant time. If the limit is later raised from 50 to
  // 100, existing grants still show the promise they were admitted under.
  limitAtGrant   Int
  grantedAt      DateTime     @default(now())

  @@index([userId])
}

// Single-row atomic counters. Postgres takes a row lock for the duration of
// an UPDATE, so
//
//   UPDATE "PlatformCounter" SET value = value + 1
//   WHERE key = 'free_tutor_signups' AND value < $limit RETURNING value
//
// admits exactly $limit callers however many run concurrently, with no retry
// loop and no read-then-write race. Counting rows in FreeTierGrant instead
// would be a classic check-then-act bug under concurrency.
model PlatformCounter {
  key       String   @id
  value     Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt
}

// ===========================================================================
// Feedback and contact messages.
//
// Deliberately a database table rather than a mailto: link. A mailto: opens
// the visitor's mail client, which many people on a phone or a shared computer
// do not have configured -- the message is simply lost, and nobody knows it
// was lost. A stored row can be queued, triaged and counted.
//
// Separate from Report: a Report is about a specific user or piece of content
// and feeds moderation. Feedback is about the product itself.
// ===========================================================================

enum FeedbackKind {
  BUG
  SUGGESTION
  COMPLAINT
  PRAISE
  QUESTION
  OTHER
}

enum FeedbackStatus {
  NEW
  TRIAGED
  ACTIONED
  CLOSED
}

model Feedback {
  id        Int            @id @default(autoincrement())
  // Null for a signed-out visitor. SetNull rather than Cascade so closing an
  // account does not silently delete a bug report that is still unfixed.
  userId    Int?
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Optional even when signed out -- someone reporting a broken page should
  // not be forced to identify themselves. Without it we simply cannot reply.
  email     String?
  kind      FeedbackKind   @default(OTHER)
  message   String
  // Where they were when they hit the problem. Far more useful for a bug
  // report than asking the reporter to describe the page.
  pageUrl   String?
  userAgent String?
  status    FeedbackStatus @default(NEW)
  adminNote String?
  handledBy Int?
  resolvedAt DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @default(now()) @updatedAt

  @@index([status, createdAt])
  @@index([userId])
}
