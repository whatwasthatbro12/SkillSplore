# ---------------------------------------------------------------------------
# SkillSplore environment configuration
# Copy to .env and adjust. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# Explicit application environment. One of: development | demo | production
# Production safety is NEVER inferred from the hostname — it is read from here.
APP_ENV=development

# --- Web / API URLs ---------------------------------------------------------
API_PORT=4000
# Public origin of the web app, used for links in emails and CORS.
WEB_ORIGIN=http://localhost:5173
# Public base URL of the API (used by the web client).
VITE_API_URL=http://localhost:4000

# --- Database ---------------------------------------------------------------
# Standard PostgreSQL connection string. No proprietary provider required.
DATABASE_URL=postgresql://skillsplore:skillsplore@localhost:5432/skillsplore?schema=public

# --- Sessions / security ----------------------------------------------------
# REQUIRED in production. Must be a long random string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=dev-only-insecure-session-secret-change-me

# Comma-separated addresses granted ADMIN on every boot. The account must
# already exist -- register through the site first, then restart. Never
# creates an account, never revokes anyone. This is how you make yourself an
# administrator on a host with no shell access.
ADMIN_EMAILS=

# Set to 1 to delete the fictional demo accounts on the next boot, for hosts
# with no shell to run apps/api/prisma/removeDemoData.ts from. Only ever
# matches @demo.skillsplore.local, an unroutable domain no real person can
# hold, and refuses while every administrator is a demo account. Idempotent --
# once they are gone it does nothing, so leaving it set is harmless.
REMOVE_DEMO_DATA=

# Google Search Console ownership token — the `content` value from the
# "HTML tag" verification method. Set this rather than uploading the HTML
# file: Render's free tier has no persistent disk, so an uploaded file
# disappears on the next redeploy and the property loses verified status.
GOOGLE_SITE_VERIFICATION=
# Cookie settings are hardened automatically when APP_ENV=production.
# Set to 1 to force secure cookies behind an HTTPS reverse proxy in non-prod.
FORCE_SECURE_COOKIES=0

# --- Email (generic SMTP; Mailpit in local demo) ----------------------------
# In development/demo the defaults point at the Mailpit capture container.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=0
MAIL_FROM="SkillSplore <no-reply@skillsplore.local>"

# --- Object storage (S3-compatible; MinIO in local demo) --------------------
# STORAGE_DRIVER: local | s3
# "local" writes to ./storage-data and needs no external service.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage-data
# When STORAGE_DRIVER=s3:
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=skillsplore
S3_ACCESS_KEY=skillsplore
S3_SECRET_KEY=skillsplore-secret
S3_FORCE_PATH_STYLE=1

# --- Demonstration controls -------------------------------------------------
# Show the "Demonstration environment — data may be reset." banner.
# Ignored (forced off) when APP_ENV=production.
SHOW_DEMO_BANNER=1
# Allow documented demo login shortcuts. Forced off in production.
ENABLE_DEMO_LOGIN=1

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
# Per-account lockout (separate from the IP-based limit above): failed logins
# before a specific account is temporarily locked, and for how long.
LOGIN_LOCKOUT_THRESHOLD=8
LOGIN_LOCKOUT_MINUTES=15

# --- Optional: LinkedIn marketing agent (apps/marketing-agent) --------------
# A separate, optional service — see apps/marketing-agent/README.md. It has
# its own .env, its own database, its own deployment. Setting this only adds
# a link in the admin nav; leaving it unset hides the link entirely and the
# marketplace is otherwise completely unaffected either way.
VITE_MARKETING_AGENT_URL=
